# Home Assistant 运行时配置与数据（由 HA 在服务器上生成，不入库）
/config/*
!/config/.gitkeep

# 敏感信息
secrets.yaml
*.secret
.env

# 备份与归档
backups/
*.zip
*.tar.gz

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 本地账号信息（不入库）
accounts.private.md

# 本机发布扫描规则（含服务器 IP、账号、设备 ID 等；绝不入库）
sensitive-patterns.txt
